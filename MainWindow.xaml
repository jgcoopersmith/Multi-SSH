<Window x:Class="MultiSSH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiSSH.Views"
        Title="Multi-SSH" Height="720" Width="1080"
        Icon="Assets/multissh.ico"
        Background="{DynamicResource Chrome.WindowBg}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Background" Value="{DynamicResource Chrome.ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Chrome.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Chrome.ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Toolbar/sidebar buttons never take keyboard focus away from the terminal. -->
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- Compact variant so the four view layouts fit in a 2x2 block -->
        <Style TargetType="Button" x:Key="ViewBtn" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,3,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Expand/collapse triangle for the session-manager tree. -->
        <Style x:Key="TreeToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow" Fill="{DynamicResource Chrome.MutedText}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 0 8 Z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 4 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Chrome.ToolbarBg}" Padding="8">
            <DockPanel LastChildFill="False">
                <!-- Left: session/view controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="NewBtn" Content="＋ New Session" Style="{StaticResource ToolBtn}" Click="New_Click"/>
                    <Button x:Name="OpenBtn" Content="▶ Open" Style="{StaticResource ToolBtn}" Click="Open_Click"/>
                    <Button x:Name="EditBtn" Content="✎ Edit" Style="{StaticResource ToolBtn}" Click="Edit_Click"/>
                    <Button x:Name="DupBtn" Content="⧉ Duplicate" Style="{StaticResource ToolBtn}" Click="Duplicate_Click"/>
                    <Button x:Name="RecordBtn" Style="{StaticResource ToolBtn}" Click="Record_Click"
                            ToolTip="Record all sessions' output to transcript files">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecordDot" Width="9" Height="9" Margin="0,0,5,0"
                                     VerticalAlignment="Center" Fill="#777777"/>
                            <TextBlock x:Name="RecordLabel" Text="Record" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HotKeysBtn" Content="⌨ Hot Keys" Style="{StaticResource ToolBtn}" Click="HotKeys_Click"/>
                    <Button x:Name="ThemeBtn" Content="🌙 Dark" Style="{StaticResource ToolBtn}" Click="Theme_Click"
                            ToolTip="Toggle light / dark theme"/>
                    <Button x:Name="CurlBtn" Content="🌐 Curl" Style="{StaticResource ToolBtn}" Click="Curl_Click"
                            ToolTip="Open the curl connectivity tester"/>
                    <Button x:Name="SettingsBtn" Content="⚙ Settings" Style="{StaticResource ToolBtn}" Click="Settings_Click"/>
                    <Separator Margin="6,0" Background="{DynamicResource Chrome.Border}"/>
                    <TextBlock Text="View:" Foreground="{DynamicResource Chrome.MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <!-- Four layouts in a compact 2x2 block -->
                    <UniformGrid Rows="2" Columns="2" VerticalAlignment="Center">
                        <Button x:Name="TabsBtn" Content="▭ Tabs" Style="{StaticResource ViewBtn}"
                                ToolTip="One session at a time, in tabs" Click="Tabs_Click"/>
                        <Button x:Name="TilesBtn" Content="▦ Grid" Style="{StaticResource ViewBtn}"
                                ToolTip="Tile every session in a grid" Click="Tiles_Click"/>
                        <Button x:Name="TilesVBtn" Content="▥ Vert" Style="{StaticResource ViewBtn}"
                                ToolTip="Tile vertically — sessions stacked in full-width rows" Click="TilesVertical_Click"/>
                        <Button x:Name="LayeredBtn" Content="⧉ Layer" Style="{StaticResource ViewBtn}"
                                ToolTip="Layered — sessions cascaded; click one to bring it to the front"
                                Click="Layered_Click"/>
                    </UniformGrid>
                </StackPanel>

                <!-- Right: broadcast one command to every open session -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Send to all:" Foreground="{DynamicResource Chrome.MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="BroadcastCombo" Width="240" IsEditable="True" Height="26"
                              VerticalContentAlignment="Center"
                              ToolTip="Type a command or pick a common one, then Send to broadcast it to every open session."
                              KeyDown="Broadcast_KeyDown">
                        <ComboBoxItem Content="ls -la"/>
                        <ComboBoxItem Content="pwd"/>
                        <ComboBoxItem Content="whoami"/>
                        <ComboBoxItem Content="hostname"/>
                        <ComboBoxItem Content="uptime"/>
                        <ComboBoxItem Content="df -h"/>
                        <ComboBoxItem Content="free -h"/>
                        <ComboBoxItem Content="ps aux"/>
                        <ComboBoxItem Content="top -b -n 1"/>
                        <ComboBoxItem Content="netstat -tulpn"/>
                        <ComboBoxItem Content="ip a"/>
                        <ComboBoxItem Content="systemctl --failed"/>
                        <ComboBoxItem Content="journalctl -n 50 --no-pager"/>
                        <ComboBoxItem Content="tail -n 50 /var/log/syslog"/>
                        <ComboBoxItem Content="sudo apt update"/>
                        <ComboBoxItem Content="cd /var/log &amp;&amp; ls -la"/>
                        <ComboBoxItem Content="clear"/>
                    </ComboBox>
                    <Button x:Name="BroadcastBtn" Content="⇪ Send" Style="{StaticResource ToolBtn}"
                            Margin="6,0,0,0" Click="Broadcast_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Terminal space + dockable session manager.
             The manager can sit on the Left, Right or Bottom edge, or be
             minimized to a thin tab on that same edge. -->
        <Grid x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="Auto"/>
                <ColumnDefinition x:Name="LeftSplitCol" Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightSplitCol" Width="Auto"/>
                <ColumnDefinition x:Name="RightCol" Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="BottomSplitRow" Height="Auto"/>
                <RowDefinition x:Name="BottomRow" Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Sidebar: session manager tree (folders -> connections) -->
        <Border x:Name="SidebarBorder" Background="{DynamicResource Chrome.SidebarBg}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,10,8,6">
                    <Button x:Name="MinimizeSidebarBtn" DockPanel.Dock="Right" Content="—" Padding="6,2" Margin="0"
                            Style="{StaticResource ToolBtn}" ToolTip="Minimize to a tab" Click="MinimizeSidebar_Click"/>
                    <Button x:Name="DockBottomBtn" DockPanel.Dock="Right" Content="▤" Padding="6,2" Margin="0,0,4,0"
                            Style="{StaticResource ToolBtn}" ToolTip="Dock to bottom" Click="DockBottom_Click"/>
                    <Button x:Name="DockRightBtn" DockPanel.Dock="Right" Content="◨" Padding="6,2" Margin="0,0,4,0"
                            Style="{StaticResource ToolBtn}" ToolTip="Dock to right" Click="DockRight_Click"/>
                    <Button x:Name="DockLeftBtn" DockPanel.Dock="Right" Content="◧" Padding="6,2" Margin="0,0,4,0"
                            Style="{StaticResource ToolBtn}" ToolTip="Dock to left" Click="DockLeft_Click"/>
                    <Button x:Name="NewFolderBtn" DockPanel.Dock="Right" Content="🗀+" Padding="6,2" Margin="0,0,4,0"
                            Style="{StaticResource ToolBtn}" ToolTip="New folder" Click="NewFolder_Click"/>
                    <TextBlock Text="SESSION MANAGER" Foreground="{DynamicResource Chrome.MutedText}" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom"
                           Text="Double-click to open · drag onto a folder to move · drag between rows to reorder · right-click for options"
                           Foreground="{DynamicResource Chrome.MutedText}" FontSize="10" TextWrapping="Wrap" Margin="10,6,10,10"/>
                <TreeView x:Name="SessionTreeView" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Chrome.Text}"
                          AllowDrop="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="Tree_MouseDoubleClick"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                          PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Tree_PreviewMouseMove"
                          DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderVm}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Vector folder icon (two-tone gold, tab + angled front) -->
                                <Viewbox Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#CD9A34" Data="M2,5 L9,5 L11,7 L22,7 L22,19 L2,19 Z"/>
                                        <Path Fill="#F5C84E" Data="M2,8 L22,8 L20.3,19 L3.7,19 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectionVm}">
                            <!-- Fills the row width; the ✕ docks to the far right and the
                                 name fills the middle (ellipsis), so they never overlap. -->
                            <DockPanel HorizontalAlignment="Stretch">
                                <Button DockPanel.Dock="Right" Content="✕" Width="16" Height="16" Padding="0"
                                        Margin="6,0,4,0" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0" Foreground="#D06060"
                                        Focusable="False"
                                        Cursor="Hand" ToolTip="Remove this connection" Click="RemoveConn_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding KindGlyph}"
                                           Foreground="{Binding KindBrush}" FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center"
                                           ToolTip="{Binding KindTip}"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Chrome.Text}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <!-- Custom template: the header column is star-width so each row
                                 fills the sidebar and the docked ✕ reaches the right edge. -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                                          Style="{StaticResource TreeToggle}" ClickMode="Press"
                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                            <Border x:Name="Bd" Grid.Row="0" Grid.Column="1"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="2,2,0,2" SnapsToDevicePixels="True">
                                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                                  HorizontalAlignment="Stretch"/>
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Chrome.SelectionBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu Opened="TreeMenu_Opened">
                            <MenuItem Header="Open" Click="MenuOpen_Click"/>
                            <MenuItem x:Name="MenuOpenAdmin" Header="Open as Administrator" Click="MenuOpenAdmin_Click"/>
                            <MenuItem Header="Edit…" Click="MenuEdit_Click"/>
                            <MenuItem Header="Duplicate" Click="MenuDuplicate_Click"/>
                            <MenuItem Header="Remove" Click="MenuDelete_Click"/>
                            <Separator/>
                            <MenuItem Header="New Folder" Click="NewFolder_Click"/>
                            <MenuItem Header="New Subfolder" Click="NewSubfolder_Click"/>
                            <MenuItem Header="Rename Folder…" Click="RenameFolder_Click"/>
                            <MenuItem Header="Delete Folder" Click="DeleteFolder_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- Minimized state: a thin tab on the docked edge that restores the panel -->
        <Border x:Name="SidebarTab" Background="{DynamicResource Chrome.SidebarBg}" Visibility="Collapsed"
                Cursor="Hand" MouseLeftButtonUp="SidebarTab_Click"
                ToolTip="Show the session manager">
            <TextBlock x:Name="SidebarTabText" Text="SESSION MANAGER" Foreground="{DynamicResource Chrome.MutedText}"
                       FontSize="11" FontWeight="Bold" Margin="6"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Drag to resize the docked panel -->
        <GridSplitter x:Name="SidebarSplitter" Background="{DynamicResource Chrome.Border}"
                      DragCompleted="SidebarSplitter_DragCompleted"/>

        <!-- Content host -->
        <Grid x:Name="ContentHost" Grid.Column="2" Grid.Row="0" Background="{DynamicResource Chrome.ContentBg}">
            <TextBlock x:Name="EmptyHint"
                       Text="No sessions open.&#x0a;Click &quot;＋ New Session&quot; or double-click a saved session."
                       Foreground="{DynamicResource Chrome.MutedText}" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
