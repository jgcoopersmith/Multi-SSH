<Window x:Class="MultiSSH.Views.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-SSH — Session Configuration"
        Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Small square buttons that pick a session type -->
        <Style TargetType="Button" x:Key="KindIcon">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#BBB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Category list (PuTTY-style) -->
        <Border Grid.Column="0" Grid.Row="0" BorderBrush="#BBB" BorderThickness="1" Background="White">
            <ListBox x:Name="CategoryList" BorderThickness="0" SelectedIndex="0"
                     SelectionChanged="CategoryList_SelectionChanged">
                <ListBoxItem Content="Session"/>
                <ListBoxItem Content="Connection"/>
                <ListBoxItem Content="Authentication"/>
                <ListBoxItem Content="Terminal"/>
                <ListBoxItem Content="Appearance"/>
                <ListBoxItem Content="Behaviour"/>
            </ListBox>
        </Border>

        <!-- Panels -->
        <Border Grid.Column="1" Grid.Row="0" Margin="10,0,0,0" BorderBrush="#BBB"
                BorderThickness="1" Background="White" Padding="14">
            <Grid>
                <!-- Session -->
                <StackPanel x:Name="PanelSession">
                    <!-- Header + one-click shortcuts for each supported session type -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="IconSsh" Tag="0" Style="{StaticResource KindIcon}"
                                    ToolTip="SSH (remote host)" Click="KindIcon_Click">
                                <TextBlock Text="SSH" FontSize="9" FontWeight="Bold" Foreground="#2E86C1"/>
                            </Button>
                            <Button x:Name="IconPs" Tag="1" Style="{StaticResource KindIcon}"
                                    ToolTip="Local — PowerShell" Click="KindIcon_Click">
                                <TextBlock Text="🌐" FontSize="13" Foreground="#2472C8"/>
                            </Button>
                            <Button x:Name="IconCmd" Tag="2" Style="{StaticResource KindIcon}"
                                    ToolTip="Local — CMD" Click="KindIcon_Click">
                                <TextBlock Text="&gt;_" FontSize="12" FontWeight="Bold" Foreground="#606060"/>
                            </Button>
                            <Button x:Name="IconBash" Tag="3" Style="{StaticResource KindIcon}"
                                    ToolTip="Local — Bash (Git for Windows)" Click="KindIcon_Click">
                                <TextBlock Text="$" FontSize="14" FontWeight="Bold" Foreground="#2E7D14"/>
                            </Button>
                            <Button x:Name="IconWsl" Tag="4" Style="{StaticResource KindIcon}"
                                    ToolTip="Local — WSL" Click="KindIcon_Click">
                                <TextBlock Text="🐧" FontSize="13" Foreground="#E95420"/>
                            </Button>
                            <Button x:Name="IconSftp" Tag="5" Style="{StaticResource KindIcon}"
                                    ToolTip="SFTP — file transfer" Click="KindIcon_Click">
                                <TextBlock Text="⇅" FontSize="14" FontWeight="Bold" Foreground="#17A2B8"/>
                            </Button>
                            <Button x:Name="IconScp" Tag="6" Style="{StaticResource KindIcon}"
                                    ToolTip="SCP — file copy" Click="KindIcon_Click">
                                <TextBlock Text="⇄" FontSize="14" FontWeight="Bold" Foreground="#6D28D9"/>
                            </Button>
                            <Button x:Name="IconWebdav" Tag="7" Style="{StaticResource KindIcon}"
                                    ToolTip="WebDAV — HTTP file" Click="KindIcon_Click">
                                <TextBlock Text="☁" FontSize="13" Foreground="#B45309"/>
                            </Button>
                            <Button x:Name="IconWscp" Tag="8" Style="{StaticResource KindIcon}"
                                    ToolTip="WSCP — WinSCP-style dual-pane file manager" Click="KindIcon_Click">
                                <TextBlock Text="🗂" FontSize="13" Foreground="#2E7D32"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Basic options for your session" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Session type" VerticalAlignment="Center" Grid.Row="0"/>
                        <ComboBox x:Name="KindCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                  SelectionChanged="KindCombo_SelectionChanged"
                                  ToolTip="SSH connects to a remote host. The local shells run on this PC.">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SSH" FontWeight="Bold" FontSize="10" Foreground="#2E86C1"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="SSH (remote host)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="13" Foreground="#2472C8"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Local — PowerShell" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&gt;_" FontWeight="Bold" FontSize="12" Foreground="#606060"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Local — CMD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="$" FontWeight="Bold" FontSize="13" Foreground="#2E7D14"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Local — Bash (Git for Windows)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🐧" FontSize="13" Foreground="#E95420"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Local — WSL" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⇅" FontWeight="Bold" FontSize="14" Foreground="#17A2B8"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="SFTP (file transfer)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⇄" FontWeight="Bold" FontSize="14" Foreground="#6D28D9"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="SCP (file copy)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☁" FontSize="13" Foreground="#B45309"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="WebDAV (HTTP file)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗂" FontSize="13" Foreground="#2E7D32"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="WSCP (file manager)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>

                        <TextBlock x:Name="HostLabel" Text="Host Name (or IP)" VerticalAlignment="Center" Grid.Row="1"/>
                        <TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                        <TextBlock x:Name="PortLabel" Text="Port" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,44,0"/>
                        <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="2" Width="40"
                                 HorizontalAlignment="Right" Margin="0,4" Text="22"/>

                        <TextBlock Text="Saved session name" Grid.Row="2" VerticalAlignment="Center"/>
                        <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

                        <TextBlock Text="Folder" Grid.Row="3" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FolderCombo" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                  Margin="0,4" IsEditable="True"
                                  ToolTip="Group this connection under a folder (e.g. Client A/Prod). Blank = top level."/>
                    </Grid>
                    <TextBlock x:Name="KindHint" Margin="0,14,0,4" Text="Connection type: SSH (port 22)" Foreground="#555"/>
                    <CheckBox x:Name="SaveChk" Content="Save this session to the sidebar" Margin="0,10,0,0" IsChecked="True"/>
                </StackPanel>

                <!-- Connection -->
                <StackPanel x:Name="PanelConnection" Visibility="Collapsed">
                    <TextBlock Text="Options controlling the connection" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Login username" VerticalAlignment="Center" Grid.Row="0"/>
                        <TextBox x:Name="UserBox" Grid.Row="0" Grid.Column="1" Margin="0,4"/>
                        <TextBlock Text="Connect timeout (seconds)" Grid.Row="1" VerticalAlignment="Center"/>
                        <TextBox x:Name="TimeoutBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="15"/>
                    </Grid>

                    <!-- Keepalive -->
                    <TextBlock Text="Sending of null packets to keep session active" FontWeight="Bold" Margin="0,16,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Seconds between keepalives (0 to turn off)" VerticalAlignment="Center" Width="260"/>
                        <TextBox x:Name="KeepAliveBox" Width="60" VerticalContentAlignment="Center" Text="0"/>
                    </StackPanel>

                    <!-- Low-level TCP -->
                    <TextBlock Text="Low-level TCP connection options" FontWeight="Bold" Margin="0,16,0,8"/>
                    <CheckBox x:Name="NoDelayChk" Content="Disable Nagle's algorithm (TCP_NODELAY option)" Margin="0,3" IsChecked="True"/>
                    <CheckBox x:Name="SoKeepaliveChk" Content="TCP keepalives (SO_KEEPALIVE) — always on: a dead connection is reported within ~35 s"
                              Margin="0,3" IsChecked="True" IsEnabled="False"/>

                    <!-- IP version -->
                    <TextBlock Text="Internet protocol version" FontWeight="Bold" Margin="0,16,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbIpAuto" GroupName="IpVerConn" Content="Auto" Margin="0,0,16,0" IsChecked="True"/>
                        <RadioButton x:Name="RbIpv4"   GroupName="IpVerConn" Content="IPv4" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RbIpv6"   GroupName="IpVerConn" Content="IPv6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Authentication -->
                <StackPanel x:Name="PanelAuth" Visibility="Collapsed">
                    <TextBlock Text="Options controlling SSH authentication" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Method" VerticalAlignment="Center" Grid.Row="0"/>
                        <ComboBox x:Name="AuthCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                  SelectionChanged="AuthCombo_SelectionChanged">
                            <!-- Order must match the AuthMethod enum: Password, PublicKey, Agent, KeyboardInteractive -->
                            <ComboBoxItem Content="Password"/>
                            <ComboBoxItem Content="Public key (private key file)"/>
                            <ComboBoxItem Content="Agent (falls back to password)"/>
                            <ComboBoxItem Content="Keyboard-interactive"/>
                        </ComboBox>

                        <TextBlock Text="Password" Grid.Row="1" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="PassBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

                        <TextBlock Text="Private key file" Grid.Row="2" VerticalAlignment="Center"/>
                        <TextBox x:Name="KeyPathBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                        <Button x:Name="BrowseKeyBtn" Content="Browse…" Grid.Row="2" Grid.Column="2"
                                Margin="6,4,0,4" Padding="8,2" Click="BrowseKey_Click"/>

                        <TextBlock Text="Key passphrase" Grid.Row="3" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="PassphraseBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>
                    </Grid>
                    <TextBlock Text="Note: passwords are stored encrypted per-Windows-user (DPAPI)."
                               Foreground="#777" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Terminal -->
                <StackPanel x:Name="PanelTerminal" Visibility="Collapsed">
                    <TextBlock Text="Options controlling the terminal emulation" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Terminal type string" VerticalAlignment="Center" Grid.Row="0"/>
                        <ComboBox x:Name="TermTypeBox" Grid.Row="0" Grid.Column="1" Margin="0,4" IsEditable="True" Text="xterm-256color">
                            <ComboBoxItem Content="xterm-256color"/>
                            <ComboBoxItem Content="xterm"/>
                            <ComboBoxItem Content="xterm-color"/>
                            <ComboBoxItem Content="vt100"/>
                            <ComboBoxItem Content="vt220"/>
                            <ComboBoxItem Content="ansi"/>
                            <ComboBoxItem Content="linux"/>
                            <ComboBoxItem Content="screen"/>
                            <ComboBoxItem Content="screen-256color"/>
                            <ComboBoxItem Content="tmux-256color"/>
                            <ComboBoxItem Content="putty"/>
                            <ComboBoxItem Content="putty-256color"/>
                            <ComboBoxItem Content="dumb"/>
                        </ComboBox>
                        <TextBlock Text="Initial columns" Grid.Row="1" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColsBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="80"/>
                        <TextBlock Text="Initial rows" Grid.Row="2" VerticalAlignment="Center"/>
                        <TextBox x:Name="RowsBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Text="24"/>
                        <TextBlock Text="Lines of scrollback" Grid.Row="3" VerticalAlignment="Center"/>
                        <TextBox x:Name="ScrollbackBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="2000"/>
                    </Grid>
                </StackPanel>

                <!-- Appearance -->
                <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                    <TextBlock Text="Options controlling font and colours" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Font family" VerticalAlignment="Center" Grid.Row="0"/>
                        <ComboBox x:Name="FontCombo" Grid.Row="0" Grid.Column="1" Margin="0,4" IsEditable="True">
                            <ComboBoxItem Content="Consolas"/>
                            <ComboBoxItem Content="Cascadia Mono"/>
                            <ComboBoxItem Content="Cascadia Code"/>
                            <ComboBoxItem Content="Lucida Console"/>
                            <ComboBoxItem Content="Courier New"/>
                        </ComboBox>
                        <TextBlock Text="Font size" VerticalAlignment="Center" Grid.Row="1"/>
                        <TextBox x:Name="FontSizeBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="14"/>
                        <TextBlock Text="Colour scheme" VerticalAlignment="Center" Grid.Row="2"/>
                        <ComboBox x:Name="SchemeCombo" Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <ComboBoxItem Content="Campbell"/>
                            <ComboBoxItem Content="PuTTY"/>
                            <ComboBoxItem Content="Solarized Dark"/>
                            <ComboBoxItem Content="Dracula"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <!-- Behaviour -->
                <StackPanel x:Name="PanelBehaviour" Visibility="Collapsed">
                    <TextBlock Text="Options controlling terminal behaviour" FontWeight="Bold" Margin="0,0,0,12"/>
                    <CheckBox x:Name="BellChk" Content="Enable terminal bell" Margin="0,4" IsChecked="True"/>
                    <CheckBox x:Name="CopySelChk" Content="Copy to clipboard on selection (PuTTY style)" Margin="0,4" IsChecked="True"/>
                    <CheckBox x:Name="RightPasteChk" Content="Paste on right-click" Margin="0,4" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ConnectBtn" Content="Save" Width="90" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="Connect_Click"/>
            <Button Content="Cancel" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
